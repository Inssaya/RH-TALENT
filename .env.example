# Copy to .env and fill. Never commit .env.

# ---- required
DOMAIN=localhost                 # your domain for automatic HTTPS; use :80 for a local HTTP test
PUBLIC_URL=https://localhost     # public base URL (links in e-mails, sitemap, JSON-LD)
SECRET_KEY=                      # 64+ random characters: python -c "import secrets;print(secrets.token_urlsafe(64))"
POSTGRES_PASSWORD=               # openssl rand -hex 24
ADMIN_EMAIL=admin@example.com    # platform administrator, created at first start
ADMIN_PASSWORD=                  # 12+ characters, change after first login

# ---- cookies and CORS (same-origin deployment: keep defaults except COOKIE_SECURE)
COOKIE_SECURE=true               # false only for plain-HTTP local tests
CORS_ORIGINS=https://localhost

# ---- AI (optional: without a key the platform runs on deterministic rules)
MISTRAL_API_KEY=
LLM_MODEL=mistral-small-latest
OCR_MODEL=mistral-ocr-latest
EMBEDDINGS_PROVIDER=hash         # hash | mistral | bge-m3 (bge-m3 needs the sentence-transformers extra)
SEM_LOW=0.05                     # recalibrate when you change the embeddings provider (see docs/evaluation.md)
SEM_HIGH=0.55
AI_DAILY_CV_CAP_PER_ORG=2000
AI_DAILY_CHAT_CAP_PER_ORG=300

# ---- e-mail (SMTP, e.g. Brevo). Empty host: messages are only logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=TalentMatch <no-reply@example.com>

# ---- files
STORAGE_BACKEND=local            # local | s3
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=eu-central
MAX_UPLOAD_MB=10
CLAMAV_HOST=                     # set to "clamav" and run with: docker compose --profile antivirus up -d
TURNSTILE_SECRET=                # Cloudflare Turnstile secret; the frontend widget is not wired yet (see README)

# ---- GDPR
NOTICE_VERSION=2026-11
RETENTION_MONTHS=24
ERASURE_DAYS=30
REJECT_UNDO_MINUTES=10

# ---- monitoring
SENTRY_DSN=
